# Committed on purpose.
#
# This branch is the control case for the `php` branch, which ships neither
# `.env` nor `.env.example`. A Symfony app normally commits a `.env` holding
# non-secret defaults and keeps real secrets in `.env.local` (gitignored) or in
# real environment variables — so a deploy tool that only looks for a
# `.env.example` to seed from will find nothing here, which is the point.
#
# APP_SECRET below is a placeholder, not a credential. This app has no sessions,
# no forms and no CSRF tokens, so nothing is protected by it. Generate a real
# one before using any of this for anything real:
#
#   php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=placeholder-not-a-real-secret-replace-me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
